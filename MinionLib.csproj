<Project Sdk="Godot.NET.Sdk/4.5.1">
    <Import Project=".\local.props" Condition="Exists('.\local.props')"/>

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable> <!--Makes code analysis regarding null values stricter.-->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <DefaultItemExcludes>packages/**</DefaultItemExcludes>
        <AppOutputBase>$(MSBuildProjectDirectory)\</AppOutputBase>
        <PathMap>$(AppOutputBase)=.\</PathMap>
        <LangVersion>preview</LangVersion>
    </PropertyGroup>

    <PropertyGroup>
        <Sts2Path Condition="'$(Sts2Path)' == '' and '$(SteamLibraryPath)' != ''">$(SteamLibraryPath)\common\Slay the Spire 2</Sts2Path>
        <ModsPath Condition="'$(ModsPath)' == '' and '$(Sts2Path)' != ''">$(Sts2Path)\mods\</ModsPath>
        <Sts2DataDir Condition="'$(Sts2DataDir)' == '' and '$(Sts2Path)' != ''">$(Sts2Path)\data_sts2_windows_x86_64</Sts2DataDir>
    </PropertyGroup>

    <PropertyGroup>
        <!-- Diasble architecture mismatch warning; mods are ideally built for all platforms (MSIL)
             while your local StS2 version will be for your specific platform. -->
        <NoWarn>$(NoWarn);MSB3270</NoWarn>
    </PropertyGroup>

    <ItemGroup Condition="Exists('$(Sts2DataDir)')">
        <Reference Include="0Harmony">
            <HintPath>$(Sts2DataDir)/0Harmony.dll</HintPath>
            <Private>false</Private>
        </Reference>
        <Reference Include="sts2">
            <HintPath>$(Sts2DataDir)/sts2.dll</HintPath>
            <Private>false</Private>
            <Publicize>False</Publicize> <!--Allows private/protected field references but may cause errors.-->
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <!--<PackageReference Include="Alchyr.Sts2.ModAnalyzers" Version="*"/>-->
        <AdditionalFiles Include="MinionLib/localization/**/*.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- 屏蔽源生成器项目 -->
        <Compile Remove="MinionLib.Generators\**"/>
        <Content Remove="MinionLib.Generators\**"/>
        <None Remove="MinionLib.Generators\**"/>
        <EmbeddedResource Remove="MinionLib.Generators\**"/>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="MinionLib/**"/>
        <Compile Remove="MinionLib.Example/**/*.cs"/>
        <Compile Remove="MinionLib.BaseLibCompat/**/*.cs"/>
        <Compile Remove="MinionLib.RitsuCompat/**/*.cs"/>
        <Compile Remove="materials/**"/>
        <Compile Remove="shaders/**"/>
        <Compile Remove="images/**"/>
        <EmbeddedResource Remove="MinionLib/**"/>
        <EmbeddedResource Remove="MinionLib.Example/**"/>
        <EmbeddedResource Remove="MinionLib.BaseLibCompat/**"/>
        <EmbeddedResource Remove="MinionLib.RitsuCompat/**"/>
        <EmbeddedResource Remove="materials/**"/>
        <EmbeddedResource Remove="shaders/**"/>
        <EmbeddedResource Remove="images/**"/>
    </ItemGroup>

    <ItemGroup>
        <None Include=".gitignore"/>
        <None Include="MinionLib.template.json"/>
        <None Include="project.godot"/>
        <None Include="MinionLib/**"/>
        <None Include="images/**"/>
    </ItemGroup>

    <ItemGroup>
        <Content Include=".agent/*"/>
        <Content Include="LICENSE"/>
        <Content Include="README.md"/>
        <Content Include="docs/**/*"/>
        <Content Include="local.props.template"/>
        <None Include="Tools\ComponentCodeGeneration\**"/>
    </ItemGroup>

    <Target Name="EnsureLocalProps" BeforeTargets="PrepareForBuild" Condition="!Exists('.\local.props')">
        <Error Text="Missing '.\local.props'. Copy '.\local.props.template' to '.\local.props', then update 'SteamLibraryPath' / 'Sts2Path' / 'ModsPath' / 'Sts2DataDir' / 'GodotPath' for your local environment."/>
    </Target>

    <Target Name="CheckDependencyPaths" BeforeTargets="ResolveAssemblyReferences">
        <Error
                Text="Slay the Spire 2 data not found at path '$(Sts2DataDir)'. Update 'Sts2Path' / 'Sts2DataDir' in local.props."
                Condition="'$(Sts2DataDir)' == '' or !Exists('$(Sts2DataDir)\sts2.dll')"/>
        <Error
                Text="Godot not found at path '$(GodotPath)'. Update 'GodotPath' in local.props."
                Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')"/>
    </Target>

    <!-- 自动更新 json 中的版本号 -->
    <Target Name="UpdateManifestVersion" BeforeTargets="BeforeBuild;PreparePckForPack">
        <PropertyGroup>
            <ManifestTemplateFile>$(MSBuildProjectDirectory)\MinionLib.template.json</ManifestTemplateFile>
            <ManifestOutputFile>$(MSBuildProjectDirectory)\MinionLib.json</ManifestOutputFile>
        </PropertyGroup>

        <Message Text="Updating version in $(ManifestOutputFile) to $(Version)" Importance="high"/>

        <ItemGroup>
            <FileLines Include="$([System.IO.File]::ReadAllText($(ManifestTemplateFile)).Replace('VERSION-CODE', '$(Version)'))"/>
        </ItemGroup>

        <WriteLinesToFile File="$(ManifestOutputFile)" Lines="@(FileLines)" Overwrite="true" WriteOnlyWhenDifferent="true"/>
    </Target>

    <!-- 构建后自动将此模组的 dll, manifest 和依赖模组的文件复制到 mods 目录 -->
    <Target Name="CopyToModsFolderOnBuild" AfterTargets="PostBuildEvent">
        <Message Text="Copying .dll and manifest to mods folder." Importance="high"/>
        <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"/>
        <Copy SourceFiles="MinionLib.json" DestinationFolder="$(ModsPath)$(MSBuildProjectName)/"/>
    </Target>

    <!--执行 Godot 导出命令将核心库 .pck 导出到 mods 目录 -->
    <Target Name="GodotPublish" AfterTargets="Publish" Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)') and '$(IsInnerGodotExport)' != 'true'">
        <Message Text="Exporting Godot .pck to mods folder" Importance="high"/>
        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;MinionLibCoreExport&quot; &quot;$(ModsPath)$(MSBuildProjectName)/$(MSBuildProjectName).pck&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <Target Name="GodotPublishSkipped" AfterTargets="Publish" Condition="'$(GodotPath)' == '' or !Exists('$(GodotPath)')">
        <Message Text="Skipping Godot .pck export because GodotPath is not configured." Importance="high"/>
    </Target>

    <PropertyGroup>
        <PackageId>FuYnAloft.Sts2.MinionLib</PackageId>
        <Version>0.0.0.0-dev</Version> <!-- 版本号由命令行参数传入 -->
        <Authors>FuYnAloft</Authors>
        <Description>A framework library for Slay the Spire 2 modding. Provides standardized systems for implementing "Minions" (summoned allies) and "Component-based Cards" (modular card logic). Includes source generators to minimize boilerplate.</Description>
        <PackageLicenseExpression>LGPL-3.0-only</PackageLicenseExpression>
        <RepositoryUrl>https://github.com/FuYnAloft/MinionLib</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddFilesToNuGetPackage</TargetsForTfmSpecificContentInPackage>

        <!-- 关键：禁止自动打包 Content，由我们下方手动指定 -->
        <IncludeContentInPack>false</IncludeContentInPack>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="MinionLib.Generators/MinionLib.Generators.csproj"
                          OutputItemType="Analyzer"
                          ReferenceOutputAssembly="false"
                          Pack="false"/>
    </ItemGroup>

    <PropertyGroup>
        <PackPckPath>$(BaseIntermediateOutputPath)pack/$(MSBuildProjectName).pck</PackPckPath>
        <GeneratorDllPath>$(MSBuildProjectDirectory)\MinionLib.Generators\bin\$(Configuration)\netstandard2.0\MinionLib.Generators.dll</GeneratorDllPath>
    </PropertyGroup>

    <!-- 打包时检查配置 -->
    <Target Name="EnforceVersionOnPack" BeforeTargets="AddFilesToNuGetPackage">
        <Error Condition="'$(Version)' == '0.0.0.0-dev'"
               Text="[打包失败] 发布 NuGet 包时需要指定版本号！示例: -p:Version=0.1.0"/>
    </Target>

    <!-- 打包前准备 Godot pck（如果本机可用 Godot） -->
    <Target Name="PreparePckForPack"
            BeforeTargets="AddFilesToNuGetPackage"
            Condition="'$(GodotPath)' != '' and Exists('$(GodotPath)')">
        <MakeDir Directories="$(BaseIntermediateOutputPath)pack"/>

        <Exec Command="&quot;$(GodotPath)&quot; --headless --export-pack &quot;MinionLibCoreExport&quot; &quot;$(PackPckPath)&quot;"
              EnvironmentVariables="IsInnerGodotExport=true;MSBUILDDISABLENODEREUSE=1"
              ContinueOnError="WarnAndContinue"/>
    </Target>

    <!-- 显式声明 NuGet 内容，避免 Godot SDK 的默认打包行为漏掉文件 -->
    <Target Name="AddFilesToNuGetPackage" DependsOnTargets="ResolveProjectReferences;Build">
        <ItemGroup>
            <TfmSpecificPackageFile Include="MinionLib.json">
                <PackagePath>Content/MinionLib.json</PackagePath>
            </TfmSpecificPackageFile>

            <TfmSpecificPackageFile Include="$(GeneratorDllPath)">
                <PackagePath>analyzers/dotnet/cs/MinionLib.Generators.dll</PackagePath>
            </TfmSpecificPackageFile>

            <TfmSpecificPackageFile Include="$(PackPckPath)">
                <PackagePath>Content/$(MSBuildProjectName).pck</PackagePath>
            </TfmSpecificPackageFile>

            <TfmSpecificPackageFile Include="README.md">
                <PackagePath>README.md</PackagePath>
            </TfmSpecificPackageFile>
        </ItemGroup>
    </Target>
</Project>
